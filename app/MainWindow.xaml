<!-- Miller Driver Updater window chrome. Loaded at runtime with XamlReader (embedded resource), so the app builds with
     plain csc.exe. Cards and rows are added in code (MainWindow.cs). Colors are DynamicResources set from the Windows
     light/dark setting and accent color at startup. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Miller Driver Updater" Width="960" Height="720" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="WindowBg" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Border" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="Text" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="Text2" Color="#6E6E73"/>
    <SolidColorBrush x:Key="Accent" Color="#0A84FF"/>
    <SolidColorBrush x:Key="AccentTint" Color="#220A84FF"/>
    <SolidColorBrush x:Key="Hover" Color="#F2F2F7"/>
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="18,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Secondary" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Checkbox drawn to match the theme (the stock WPF one is a white Windows 7 box, glaring in dark mode). -->
    <Style TargetType="CheckBox">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Grid Width="18" Height="18" VerticalAlignment="Center">
                <Border x:Name="Box" CornerRadius="4" BorderThickness="1.5" BorderBrush="{DynamicResource Text2}" Background="Transparent"/>
                <Path x:Name="Tick" Data="M 4.6 9.3 L 7.7 12.3 L 13.4 5.9" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Grid>
              <ContentPresenter x:Name="Label" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
              <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="Label" Property="Margin" Value="0"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Thin rounded vertical scrollbar in the theme's colors (horizontal ones keep the default). -->
    <ControlTemplate x:Key="PageArea" TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
    <Style TargetType="ScrollBar">
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Vertical">
          <Setter Property="Width" Value="12"/>
          <Setter Property="MinWidth" Value="12"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                  <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Template="{StaticResource PageArea}"/></Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Template="{StaticResource PageArea}"/></Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Border x:Name="T" Width="6" CornerRadius="3" HorizontalAlignment="Center" Background="{DynamicResource Text2}" Opacity="0.4"/>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Opacity" Value="0.65"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="T" Property="Opacity" Value="0.8"/></Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
    </Style>
  </Window.Resources>
  <Grid Margin="30,24,30,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- The app icon (assets/mdu.ico, drawn by tools/ArtGen.cs); the code sets its picture. -->
        <Image x:Name="Logo" Grid.Column="0" Width="60" Height="60" Margin="-4,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Miller Driver Updater" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text2}" Margin="0,0,0,1"/>
          <TextBlock x:Name="Headline" FontSize="26" FontWeight="SemiBold" Text="Checking for updates..." TextWrapping="Wrap"/>
          <TextBlock x:Name="Subline" FontSize="13" Foreground="{DynamicResource Text2}" Margin="0,4,0,0" TextWrapping="Wrap" Text="Checking Windows Update, nvidia.com and winget. Checking never changes anything."/>
        </StackPanel>
      </Grid>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
        <Button x:Name="RescanButton" Style="{StaticResource Secondary}" Content="Check Again" Margin="0,0,10,0" Visibility="Collapsed" ToolTip="Scan again (F5)"/>
        <Button x:Name="ReportButton" Style="{StaticResource Secondary}" Content="Open Report" Margin="0,0,10,0" Visibility="Collapsed" ToolTip="The full scan as a web page: every device, driver and app found"/>
        <Button x:Name="PrimaryButton" Style="{StaticResource Primary}" Content="Checking..." MinWidth="170" IsEnabled="False" IsDefault="True"/>
      </StackPanel>
    </Grid>
    <ProgressBar x:Name="Progress" Grid.Row="1" Height="4" Margin="0,18,0,4" BorderThickness="0" Background="{DynamicResource Border}"
                 Foreground="{DynamicResource Accent}" Minimum="0" Maximum="100" IsIndeterminate="True" Visibility="Hidden"/>
    <ScrollViewer x:Name="Scroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0" Padding="0,0,6,0" Focusable="False">
      <StackPanel x:Name="Sections"/>
    </ScrollViewer>
    <StackPanel Grid.Row="3">
    <!-- A newer Miller Driver Updater on GitHub Releases. Shown only when one exists; Update is always a deliberate click. -->
    <Border x:Name="UpdateBanner" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,8,0,0" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="UpdateText" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" Text=""/>
        <Button x:Name="UpdateNotesButton" Grid.Column="1" Style="{StaticResource Secondary}" Content="What's New" Margin="12,0,0,0"/>
        <Button x:Name="UpdateButton" Grid.Column="2" Style="{StaticResource Primary}" Content="Update" Margin="10,0,0,0"/>
      </Grid>
    </Border>
    <Border x:Name="RebootBanner" Background="{DynamicResource AccentTint}" CornerRadius="10" Padding="16,12" Margin="0,8,0,0" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" Text="Restart to finish installing. Nothing restarts until you say so."/>
        <Button x:Name="LaterButton" Grid.Column="1" Style="{StaticResource Secondary}" Content="Later" Margin="12,0,0,0"/>
        <Button x:Name="RestartButton" Grid.Column="2" Style="{StaticResource Primary}" Content="Restart Now" Margin="10,0,0,0"/>
      </Grid>
    </Border>
    </StackPanel>
    <Grid Grid.Row="4" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="Status" Grid.Column="0" Foreground="{DynamicResource Text2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text=""/>
      <CheckBox x:Name="WeeklyCheck" Grid.Column="1" Content="Check weekly and notify me" Foreground="{DynamicResource Text2}" Margin="16,0,0,0" ToolTip="Mondays at 10:00, silently. A notification appears only when there is something to install."/>
      <Button x:Name="HelpButton" Grid.Column="2" Style="{StaticResource Secondary}" Content="Report a Problem" Padding="10,3" FontSize="12" Margin="16,0,0,0" ToolTip="Saves this app's logs to a zip on your desktop and opens GitHub to report the problem"/>
      <TextBlock x:Name="VersionText" Grid.Column="3" Foreground="{DynamicResource Text2}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" Text="" ToolTip="Release notes and source code on GitHub"/>
    </Grid>
  </Grid>
</Window>
